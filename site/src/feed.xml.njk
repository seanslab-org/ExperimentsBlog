---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.name }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self" />
  <link href="{{ site.url }}/" />
  <id>{{ site.url }}/</id>
  <updated>{{ collections.posts[0].date.toISOString() }}</updated>
  <author><name>{{ site.author }}</name><email>{{ site.email }}</email></author>
  {% for post in collections.posts %}
  <entry>
    <title>{{ post.data.title | xmlEscape }}</title>
    <link href="{{ post.url | absoluteUrl(site.url) }}" />
    <id>{{ post.url | absoluteUrl(site.url) }}</id>
    <updated>{{ post.date.toISOString() }}</updated>
    <summary>{{ post.data.description | xmlEscape }}</summary>
  </entry>
  {% endfor %}
</feed>
