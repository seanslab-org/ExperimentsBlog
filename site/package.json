{
  "name": "seanslab-static-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve",
    "clean": "rm -rf dist",
    "check": "node scripts/check-output.mjs",
    "import:local": "node scripts/import-local.mjs",
    "import:super": "node scripts/import-super.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "markdown-it": "14.3.0"
  },
  "overrides": {
    "@11ty/recursive-copy": "5.0.2"
  }
}
